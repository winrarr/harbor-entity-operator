{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
  ],
  baseBranchPatterns: [
    "$default",
    "/^release\\/.+$/",
  ],
  timezone: "Europe/Copenhagen",
  updateNotScheduled: false,
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",
  prTitleStrict: true,
  labels: [
    "dependencies",
  ],
  dependencyDashboard: true,
  prConcurrentLimit: 5,
  branchConcurrentLimit: 5,
  separateMinorPatch: true,
  separateMajorMinor: true,
  rebaseWhen: "behind-base-branch",
  packageRules: [
    {
      description: "Automerge patch updates after CI passes.",
      matchUpdateTypes: [
        "patch",
      ],
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "Automerge Docker digest refreshes after CI passes.",
      matchDatasources: [
        "docker",
      ],
      matchUpdateTypes: [
        "digest",
      ],
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "Release branches only receive runtime dependency updates.",
      matchBaseBranches: [
        "/^release\\/.+$/",
      ],
      matchManagers: [
        "github-actions",
        "helm-values",
        "custom.regex",
      ],
      enabled: false,
    },
    {
      description: "Release branches only receive patch-level Go dependency updates.",
      matchBaseBranches: [
        "/^release\\/.+$/",
      ],
      matchManagers: [
        "gomod",
      ],
      matchUpdateTypes: [
        "minor",
        "major",
      ],
      enabled: false,
    },
    {
      description: "Group Kubernetes ecosystem updates and derived configuration.",
      matchManagers: [
        "gomod",
        "custom.regex",
      ],
      matchPackageNames: [
        "k8s.io/**",
        "sigs.k8s.io/**",
      ],
      groupName: "Kubernetes dependencies",
    },
    {
      description: "Keep GitHub Action updates together.",
      matchManagers: [
        "github-actions",
      ],
      groupName: "GitHub Actions",
      groupSlug: "github-actions",
      separateMajorMinor: true,
      separateMinorPatch: true,
    },
    {
      description: "Do not let helm-values mutate the chart image defaults; the chart intentionally derives the image tag from Chart.appVersion when tag and digest are empty.",
      matchManagers: [
        "helm-values",
      ],
      matchFileNames: [
        "charts/harbor-entity-operator/values.yaml",
      ],
      enabled: false,
    },
    {
      description: "Keep Docker image tag updates together.",
      matchDatasources: [
        "docker",
      ],
      groupName: "Docker images",
    },
    {
      description: "Regex-managed Docker references only track tags here, so skip digest pinning.",
      matchManagers: [
        "custom.regex",
      ],
      matchDatasources: [
        "docker",
      ],
      pinDigests: false,
    },
    {
      description: "Disable devcontainer updates because the repo no longer maintains a devcontainer workflow.",
      matchManagers: [
        "devcontainer",
      ],
      enabled: false,
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Update GitHub release tool versions declared in the Makefile.",
      managerFilePatterns: [
        "/^Makefile$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+) depName=(?<depName>[^\\s]+)\\n[A-Za-z0-9_]+_VERSION\\s*\\?=\\s*[\\\"']?(?<currentValue>[^\\s\\\"']+)[\\\"']?",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      customType: "regex",
      description: "Update the Harbor version used by the local integration stack.",
      managerFilePatterns: [
        "/^Makefile$/",
      ],
      matchStrings: [
        "# renovate: datasource=docker depName=goharbor/harbor-core\\nHARBOR_VERSION\\s*\\?=\\s*(?<currentValue>[^\\s]+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Update the Kubernetes node image used by local Kind clusters.",
      managerFilePatterns: [
        "/^Makefile$/",
      ],
      matchStrings: [
        "# renovate: datasource=docker depName=kindest/node\\nKIND_NODE_IMAGE\\s*\\?=\\s*kindest/node:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Update Docker image tags referenced in the Makefile.",
      managerFilePatterns: [
        "/^Makefile$/",
      ],
      matchStrings: [
        "DOCS_CONTAINER_IMAGE\\s*\\?=\\s*(?<depName>[^:\\s]+(?:/[^:\\s]+)+):(?<currentValue>[^\\s]+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Update Docker image tags used directly in the docs workflow run command.",
      managerFilePatterns: [
        "/^\\.github\\/workflows\\/docs\\.yaml$/",
      ],
      matchStrings: [
        "(?<depName>squidfunk\\/mkdocs-material):(?<currentValue>[^\\s\"']+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Update marked Kubernetes minor versions derived from Go modules.",
      managerFilePatterns: [
        "/^hack\\/.*\\.ya?ml$/",
      ],
      matchStrings: [
        "(?<prefix>^|\\n)(?<indentation>[ \\t]*)# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)[ \\t]*\\n[ \\t]*kubernetesVersion:\\s*\"1\\.(?<minor>\\d+)\"",
      ],
      currentValueTemplate: "0.{{{minor}}}",
      extractVersionTemplate: "^v?(?<version>0\\.\\d+)\\.",
      versioningTemplate: "semver-coerced",
      autoReplaceStringTemplate: "{{{prefix}}}{{{indentation}}}# renovate: datasource={{{datasource}}} depName={{{depName}}}\n{{{indentation}}}kubernetesVersion: \"1.{{{replace '^0\\.' '' newValue}}}\"",
    },
  ],
}
